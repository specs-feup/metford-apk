{
    "projectName": "keepassdroid",
    "inputApk": "InputSources/keepassdroid.apk",
    "outputApk": "mutated-keepassdroid.apk",
    "reportPath": "reports/mutation-report-keepassdroid.json",
    "packageFilter": "com/keepassdroid",
    "excludeClasses": [
        "AbstractHashedMap",
        "PwGroupV3",
        "GroupActivity",
        "WarningDialog",
        "EntryEditActivity",
        "BrowserDialog",
        "FileSelectActivity",
        "GroupEditActivity",
        "EntryActivity"
    ],
    "verbose": true,
    "operators": [
        {
            "name": "Arithmetic",
            "from": "add",
            "to": [
                "sub"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "sub",
            "to": [
                "add"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "mul",
            "to": [
                "div"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "div",
            "to": [
                "mul"
            ]
        },
        "NullIntent",
        "IntentTargetReplacement",
        "NullPutExtraValue",
        "NullPutExtraKey",
        "BuggyGUIListener",
        "LengthyGUIListener",
        "LengthyGUICreation",
        "FindViewByIdReturnsNull",
        "InvalidIDFindView",
        "InvalidKeyIntent",
        "InvalidViewFocus",
        "ViewComponentNotVisible",
        "RandomIntentAction"
    ]
}