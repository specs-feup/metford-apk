{
    "projectName": "AntennaPod",
    "inputApk": "InputSources/AntennaPod.apk",
    "outputApk": "mutated-antennapod.apk",
    "reportPath": "reports/mutation-report-antennapod.json",
    "packageFilter": "de/danoeh/antennapod",
    "verbose": true,
    "operators": [
        {
            "name": "Arithmetic",
            "from": "add",
            "to": [
                "sub"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "sub",
            "to": [
                "add"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "mul",
            "to": [
                "div"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "div",
            "to": [
                "mul"
            ]
        },
        "NullIntent",
        "IntentTargetReplacement",
        "NullPutExtraValue",
        "NullPutExtraKey",
        "BuggyGUIListener",
        "LengthyGUIListener",
        "LengthyGUICreation",
        "FindViewByIdReturnsNull",
        "InvalidIDFindView",
        "InvalidKeyIntent",
        "InvalidViewFocus",
        "ViewComponentNotVisible",
        "RandomIntentAction"
    ]
}