{
    "projectName": "AmazeFileManager",
    "inputApk": "InputSources/AmazeFileManager.apk",
    "outputApk": "mutated-amaze.apk",
    "reportPath": "reports/mutation-report-amaze.json",
    "packageFilter": "com/amaze/filemanager",
    "excludeClasses": [
        "MainActivity",
        "Drawer",
        "ShareTask"
    ],
    "verbose": true,
    "operators": [
        {
            "name": "Arithmetic",
            "from": "add",
            "to": [
                "sub"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "sub",
            "to": [
                "add"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "mul",
            "to": [
                "div"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "div",
            "to": [
                "mul"
            ]
        },
        "NullIntent",
        "IntentTargetReplacement",
        "NullPutExtraValue",
        "NullPutExtraKey",
        "BuggyGUIListener",
        "LengthyGUIListener",
        "LengthyGUICreation",
        "FindViewByIdReturnsNull",
        "InvalidIDFindView",
        "InvalidKeyIntent",
        "InvalidViewFocus",
        "ViewComponentNotVisible",
        "RandomIntentAction"
    ]
}