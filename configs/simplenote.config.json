{
    "projectName": "simplenote-android",
    "inputApk": "InputSources/simplenote-android.apk",
    "outputApk": "mutated-simplenote.apk",
    "reportPath": "reports/mutation-report-simplenote.json",
    "packageFilter": "com/automattic/simplenote",
    "excludeClasses": [
        "PrefUtils",
        "WordPressUtils",
        "SimplenoteCredentialsActivity",
        "Simplenote",
        "SimplenoteAppLock",
        "StyleActivity",
        "NotesActivity",
        "TagsAdapter",
        "SpaceTokenizer"
    ],
    "verbose": true,
    "operators": [
        {
            "name": "Arithmetic",
            "from": "add",
            "to": [
                "sub"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "sub",
            "to": [
                "add"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "mul",
            "to": [
                "div"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "div",
            "to": [
                "mul"
            ]
        },
        "NullIntent",
        "IntentTargetReplacement",
        "NullPutExtraValue",
        "NullPutExtraKey",
        "BuggyGUIListener",
        "LengthyGUIListener",
        "LengthyGUICreation",
        "FindViewByIdReturnsNull",
        "InvalidIDFindView",
        "InvalidKeyIntent",
        "InvalidViewFocus",
        "ViewComponentNotVisible",
        "RandomIntentAction"
    ]
}