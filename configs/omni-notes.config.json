{
    "projectName": "Omni-Notes",
    "inputApk": "InputSources/Omni-Notes.apk",
    "outputApk": "mutated-omni-notes.apk",
    "reportPath": "reports/mutation-report-omni-notes.json",
    "packageFilter": "it/feio/android/omninotes",
    "excludeClasses": [
        "IntroActivity",
        "GalleryActivity",
        "DetailFragment",
        "CategoryActivity",
        "ListFragment",
        "GeocodeHelper",
        "OmniNotes",
        "SettingsFragment",
        "UpgradeProcessor",
        "NotificationsHelper",
        "CategoryBaseAdapter",
        "ShortcutHelper",
        "CategoryRecyclerViewAdapter",
        "ONStyle"
    ],
    "verbose": true,
    "operators": [
        {
            "name": "Arithmetic",
            "from": "add",
            "to": [
                "sub"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "sub",
            "to": [
                "add"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "mul",
            "to": [
                "div"
            ]
        },
        {
            "name": "Arithmetic",
            "from": "div",
            "to": [
                "mul"
            ]
        },
        "NullIntent",
        "IntentTargetReplacement",
        "NullPutExtraValue",
        "NullPutExtraKey",
        "BuggyGUIListener",
        "LengthyGUIListener",
        "LengthyGUICreation",
        "FindViewByIdReturnsNull",
        "InvalidIDFindView",
        "InvalidKeyIntent",
        "InvalidViewFocus",
        "ViewComponentNotVisible",
        "RandomIntentAction"
    ]
}