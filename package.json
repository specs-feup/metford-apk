{
  "name": "@specs-feup/metford-apk",
  "version": "0.0.1",
  "author": "J. Neves",
  "description": "Mutation testing framework for Android binaries",
  "type": "module",
  "files": [
    "api",
    "src",
    ".gitignore",
    "jest.config.js",
    "LICENSE",
    "package-lock.json",
    "package.json",
    "README.md",
    "tsconfig.jest.json",
    "tsconfig.json",
    "typedoc.config.js"
  ],
  "scripts": {
    "run": "node scripts/run.js",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint .",
    "docs": "typedoc",
    "test": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit src",
    "test:cov": "npm run test -- --coverage",
    "test:watch": "npm run test -- --watch"
  },
  "dependencies": {
    "@specs-feup/alpakka": "~1.2.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-tsdoc": "^0.5.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}
